<svg xmlns="http://www.w3.org/2000/svg" width="495" height="195" viewBox="0 0 495 195">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      {% if theme == "dark" %}
      <stop offset="0%" stop-color="#0D1117"/>
      <stop offset="100%" stop-color="#161B22"/>
      {% else %}
      <stop offset="0%" stop-color="#FFFBEB"/>
      <stop offset="100%" stop-color="#FEF3C7"/>
      {% endif %}
    </linearGradient>
    <linearGradient id="borderGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#92400E"/>
      <stop offset="50%" stop-color="#D97706"/>
      <stop offset="100%" stop-color="#F59E0B"/>
    </linearGradient>
    <filter id="shadow">
      <feDropShadow dx="0" dy="2" stdDeviation="6" flood-color="#D97706" flood-opacity="{{ '0.2' if theme == 'dark' else '0.15' }}"/>
    </filter>
  </defs>
  <rect x="1" y="1" width="493" height="193" rx="12" fill="url(#bg)" filter="url(#shadow)"/>
  <rect x="1" y="1" width="493" height="193" rx="12" fill="none" stroke="url(#borderGrad)" stroke-width="1.5"/>
  <!-- Title -->
  <text x="248" y="36" text-anchor="middle" fill="{{ '#D97706' if theme == 'dark' else '#92400E' }}" font-family="'Segoe UI', -apple-system, sans-serif" font-size="16" font-weight="600">GitHub Stats</text>
  <!-- Row 1 -->
  <text x="83" y="80" text-anchor="middle" fill="{{ '#FDE68A' if theme == 'dark' else '#92400E' }}" font-family="'Segoe UI', sans-serif" font-size="28" font-weight="700">{{ repos }}</text>
  <text x="83" y="100" text-anchor="middle" fill="{{ '#8B949E' if theme == 'dark' else '#6B7280' }}" font-family="'Segoe UI', sans-serif" font-size="11">Repos</text>
  <text x="248" y="80" text-anchor="middle" fill="{{ '#FDE68A' if theme == 'dark' else '#92400E' }}" font-family="'Segoe UI', sans-serif" font-size="28" font-weight="700">{{ stars }}</text>
  <text x="248" y="100" text-anchor="middle" fill="{{ '#8B949E' if theme == 'dark' else '#6B7280' }}" font-family="'Segoe UI', sans-serif" font-size="11">Stars</text>
  <text x="413" y="80" text-anchor="middle" fill="{{ '#FDE68A' if theme == 'dark' else '#92400E' }}" font-family="'Segoe UI', sans-serif" font-size="28" font-weight="700">{{ followers }}</text>
  <text x="413" y="100" text-anchor="middle" fill="{{ '#8B949E' if theme == 'dark' else '#6B7280' }}" font-family="'Segoe UI', sans-serif" font-size="11">Followers</text>
  <!-- Row 2 -->
  <text x="83" y="145" text-anchor="middle" fill="{{ '#FBBF24' if theme == 'dark' else '#B45309' }}" font-family="'Segoe UI', sans-serif" font-size="28" font-weight="700">{{ commits }}</text>
  <text x="83" y="165" text-anchor="middle" fill="{{ '#8B949E' if theme == 'dark' else '#6B7280' }}" font-family="'Segoe UI', sans-serif" font-size="11">Commits</text>
  <text x="248" y="145" text-anchor="middle" fill="{{ '#FBBF24' if theme == 'dark' else '#B45309' }}" font-family="'Segoe UI', sans-serif" font-size="28" font-weight="700">{{ prs }}</text>
  <text x="248" y="165" text-anchor="middle" fill="{{ '#8B949E' if theme == 'dark' else '#6B7280' }}" font-family="'Segoe UI', sans-serif" font-size="11">PRs</text>
  <text x="413" y="145" text-anchor="middle" fill="{{ '#FBBF24' if theme == 'dark' else '#B45309' }}" font-family="'Segoe UI', sans-serif" font-size="28" font-weight="700">{{ issues }}</text>
  <text x="413" y="165" text-anchor="middle" fill="{{ '#8B949E' if theme == 'dark' else '#6B7280' }}" font-family="'Segoe UI', sans-serif" font-size="11">Issues</text>
  <!-- Streak -->
  <text x="470" y="36" text-anchor="end" fill="{{ '#6B7280' if theme == 'dark' else '#9CA3AF' }}" font-family="'Segoe UI', sans-serif" font-size="10">🔥 {{ streak }} day streak</text>
</svg>
