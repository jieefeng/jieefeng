<svg xmlns="http://www.w3.org/2000/svg" width="495" height="{{ card_height }}" viewBox="0 0 495 {{ card_height }}">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      {% if theme == "dark" %}
      <stop offset="0%" stop-color="#0D1117"/>
      <stop offset="100%" stop-color="#161B22"/>
      {% else %}
      <stop offset="0%" stop-color="#FFFBEB"/>
      <stop offset="100%" stop-color="#FEF3C7"/>
      {% endif %}
    </linearGradient>
    <linearGradient id="borderGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#92400E"/>
      <stop offset="50%" stop-color="#D97706"/>
      <stop offset="100%" stop-color="#F59E0B"/>
    </linearGradient>
    <linearGradient id="cardBg" x1="0%" y1="0%" x2="0%" y2="100%">
      {% if theme == "dark" %}
      <stop offset="0%" stop-color="#1C2128"/>
      <stop offset="100%" stop-color="#161B22"/>
      {% else %}
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="100%" stop-color="#F9FAFB"/>
      {% endif %}
    </linearGradient>
    <filter id="shadow">
      <feDropShadow dx="0" dy="2" stdDeviation="6" flood-color="#D97706" flood-opacity="{{ '0.2' if theme == 'dark' else '0.15' }}"/>
    </filter>
  </defs>
  <rect x="1" y="1" width="493" height="{{ card_height - 2 }}" rx="12" fill="url(#bg)" filter="url(#shadow)"/>
  <rect x="1" y="1" width="493" height="{{ card_height - 2 }}" rx="12" fill="none" stroke="url(#borderGrad)" stroke-width="1.5"/>
  <text x="248" y="36" text-anchor="middle" fill="{{ '#D97706' if theme == 'dark' else '#92400E' }}" font-family="'Segoe UI', -apple-system, sans-serif" font-size="16" font-weight="600">📌 置顶项目</text>
  {% if repos %}
  {% for repo in repos %}
  {% set col = loop.index0 % 2 %}
  {% set row = loop.index0 // 2 %}
  {% set x = 20 + col * 238 %}
  {% set y = 50 + row * 100 %}
  <rect x="{{ x }}" y="{{ y }}" width="228" height="88" rx="10" fill="url(#cardBg)" stroke="{{ '#30363d' if theme == 'dark' else '#E5E7EB' }}" stroke-width="1"/>
  <text x="{{ x + 14 }}" y="{{ y + 24 }}" fill="{{ '#FDE68A' if theme == 'dark' else '#92400E' }}" font-family="'Segoe UI', sans-serif" font-size="13" font-weight="600">{{ repo.name[:20] }}</text>
  {% if repo.language %}
  <circle cx="{{ x + 14 }}" cy="{{ y + 40 }}" r="4" fill="{{ repo.language.color or '#8B949E' }}"/>
  <text x="{{ x + 24 }}" y="{{ y + 44 }}" fill="{{ '#8B949E' if theme == 'dark' else '#6B7280' }}" font-family="'Segoe UI', sans-serif" font-size="10">{{ repo.language.name }}</text>
  {% endif %}
  <text x="{{ x + 200 }}" y="{{ y + 24 }}" text-anchor="end" fill="{{ '#8B949E' if theme == 'dark' else '#6B7280' }}" font-family="'Segoe UI', sans-serif" font-size="10">⭐ {{ repo.stars }}</text>
  <text x="{{ x + 14 }}" y="{{ y + 64 }}" fill="{{ '#C9D1D9' if theme == 'dark' else '#374151' }}" font-family="'Segoe UI', sans-serif" font-size="10">{{ (repo.description or '')[:35] }}</text>
  {% endfor %}
  {% else %}
  <text x="248" y="55" text-anchor="middle" fill="{{ '#8B949E' if theme == 'dark' else '#6B7280' }}" font-family="'Segoe UI', sans-serif" font-size="12">暂无置顶项目</text>
  {% endif %}
</svg>
