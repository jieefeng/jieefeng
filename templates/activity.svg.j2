<svg xmlns="http://www.w3.org/2000/svg" width="760" height="172" viewBox="0 0 760 172" role="img" aria-label="近一年 {{ total_contribs }} 次贡献，当前连续 {{ streak }} 天，最长 {{ max_streak }} 天">
  {# A soft light beam sweeps left-to-right across the calendar on a slow
     loop; days it passes over briefly glow, so the eye reads the timeline
     being "scanned" without any game-like overlay. Reduced-motion swaps the
     sweep and the per-day glow off entirely. #}
  <style>
    .beam { animation: sweep {{ scan.dur }}s linear infinite; }
    @keyframes sweep {
      0%   { transform: translateX({{ scan.x0 }}px); opacity: 0; }
      6%   { opacity: 1; }
      92%  { opacity: 1; }
      100% { transform: translateX({{ scan.x1 }}px); opacity: 0; }
    }
    {% for cell in cells %}{% if cell.glow is not none %}
    .g{{ loop.index0 }} { animation: gl{{ loop.index0 }} {{ scan.dur }}s linear infinite; }
    @keyframes gl{{ loop.index0 }} {
      0%, {{ cell.glow.pre }}%   { fill: {{ cell.fill }}; }
      {{ cell.glow.mid }}%  { fill: {{ scan.glow_color }}; }
      {{ cell.glow.post }}%, 100% { fill: {{ cell.fill }}; }
    }
    {% endif %}{% endfor %}
    .motion { display: inline; }
    @media (prefers-reduced-motion: reduce) {
      .beam { display: none; }
      .motion { display: none; }
    }
  </style>
  <defs>
    <linearGradient id="abg" x1="0" y1="0" x2="1" y2="1">
      {% if theme == "dark" %}
      <stop offset="0" stop-color="#0D1117"/>
      <stop offset="1" stop-color="#161B22"/>
      {% else %}
      <stop offset="0" stop-color="#FFFBEB"/>
      <stop offset="1" stop-color="#FEF3C7"/>
      {% endif %}
    </linearGradient>
    <linearGradient id="aborder" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#92400E"/>
      <stop offset="0.5" stop-color="#D97706"/>
      <stop offset="1" stop-color="#F59E0B"/>
    </linearGradient>
    <linearGradient id="anum" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#D97706"/>
      <stop offset="1" stop-color="#F59E0B"/>
    </linearGradient>
    <linearGradient id="beamg" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="{{ scan.glow_color }}" stop-opacity="0"/>
      <stop offset="0.5" stop-color="{{ scan.glow_color }}" stop-opacity="{{ '0.55' if theme == 'dark' else '0.40' }}"/>
      <stop offset="1" stop-color="{{ scan.glow_color }}" stop-opacity="0"/>
    </linearGradient>
    <filter id="ashadow" x="-5%" y="-10%" width="110%" height="125%">
      <feDropShadow dx="0" dy="3" stdDeviation="7" flood-color="#D97706" flood-opacity="{{ '0.25' if theme == 'dark' else '0.18' }}"/>
    </filter>
    <filter id="beamblur" x="-30%" y="-10%" width="160%" height="120%">
      <feGaussianBlur stdDeviation="6"/>
    </filter>
    <clipPath id="gridclip">
      <rect x="36" y="52" width="{{ scan.grid_w }}" height="91" rx="3"/>
    </clipPath>
  </defs>

  <rect x="1" y="1" width="758" height="170" rx="14" fill="url(#abg)" filter="url(#ashadow)"/>
  <rect x="1" y="1" width="758" height="170" rx="14" fill="none" stroke="url(#aborder)" stroke-width="1.5"/>

  {% set muted = '#8B949E' if theme == 'dark' else '#6B7280' %}
  {% set muted2 = '#8B949E' if theme == 'dark' else '#9CA3AF' %}
  {% set accent = '#D97706' if theme == 'dark' else '#B45309' %}

  <!-- Header: yearly stats. The section title is carried by the README
       heading, so the card does not repeat it. -->
  <text x="28" y="31" font-family="'Segoe UI',-apple-system,sans-serif" font-size="12">
    <tspan fill="url(#anum)" font-size="16" font-weight="700">{{ total_contribs }}</tspan>
    <tspan fill="{{ muted }}"> 次贡献 · 连续 </tspan>
    <tspan fill="{{ accent }}" font-weight="600">{{ streak }}</tspan>
    <tspan fill="{{ muted }}"> 天 · 最长 </tspan>
    <tspan fill="{{ accent }}" font-weight="600">{{ max_streak }}</tspan>
    <tspan fill="{{ muted }}"> 天</tspan>
  </text>

  <!-- Month labels -->
  {% for m in months %}
  <text x="{{ m.x }}" y="47" fill="{{ muted2 }}" font-family="'Segoe UI',sans-serif" font-size="9">{{ m.label }}</text>
  {% endfor %}

  <!-- Weekday labels -->
  {% for wd in weekdays %}
  <text x="14" y="{{ wd.y }}" fill="{{ muted2 }}" font-family="'Segoe UI',sans-serif" font-size="8">{{ wd.label }}</text>
  {% endfor %}

  <!-- Heatmap grid. Cells with contributions get a per-cell glow keyframe
       timed to the moment the beam reaches them; empty days stay flat. -->
  {% for cell in cells %}
  {% if cell.glow is not none %}
  <rect class="g{{ loop.index0 }}" x="{{ cell.x }}" y="{{ cell.y }}" width="11" height="11" rx="2.5" fill="{{ cell.fill }}"/>
  {% else %}
  <rect x="{{ cell.x }}" y="{{ cell.y }}" width="11" height="11" rx="2.5" fill="{{ cell.fill }}"/>
  {% endif %}
  {% endfor %}

  <!-- The sweeping beam, clipped to the grid so it never washes over the
       card chrome. -->
  <g class="motion" clip-path="url(#gridclip)">
    <rect class="beam" x="0" y="52" width="{{ scan.beam_w }}" height="91"
          fill="url(#beamg)" filter="url(#beamblur)"/>
  </g>

  <!-- Legend -->
  <text x="36" y="161" fill="{{ muted2 }}" font-family="'Segoe UI',sans-serif" font-size="9">最近一年</text>
  <text x="628" y="161" text-anchor="end" fill="{{ muted }}" font-family="'Segoe UI',sans-serif" font-size="9">Less</text>
  {% for color in levels %}
  <rect x="{{ 632 + loop.index0 * 14 }}" y="152" width="11" height="11" rx="2.5" fill="{{ color }}"/>
  {% endfor %}
  <text x="732" y="161" text-anchor="end" fill="{{ muted }}" font-family="'Segoe UI',sans-serif" font-size="9">More</text>
</svg>
