<svg xmlns="http://www.w3.org/2000/svg" width="760" height="170" viewBox="0 0 760 170">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      {% if theme == "dark" %}
      <stop offset="0%" stop-color="#0D1117"/>
      <stop offset="100%" stop-color="#161B22"/>
      {% else %}
      <stop offset="0%" stop-color="#FFFBEB"/>
      <stop offset="100%" stop-color="#FEF3C7"/>
      {% endif %}
    </linearGradient>
    <linearGradient id="borderGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#92400E"/>
      <stop offset="50%" stop-color="#D97706"/>
      <stop offset="100%" stop-color="#F59E0B"/>
    </linearGradient>
    <linearGradient id="numGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#D97706"/>
      <stop offset="100%" stop-color="#F59E0B"/>
    </linearGradient>
    <filter id="shadow">
      <feDropShadow dx="0" dy="3" stdDeviation="7" flood-color="#D97706" flood-opacity="{{ '0.25' if theme == 'dark' else '0.18' }}"/>
    </filter>
  </defs>

  <rect x="1" y="1" width="758" height="168" rx="14" fill="url(#bg)" filter="url(#shadow)"/>
  <rect x="1" y="1" width="758" height="168" rx="14" fill="none" stroke="url(#borderGrad)" stroke-width="1.5"/>

  <!-- Header: title left, stats right -->
  <text x="28" y="32" fill="{{ '#F59E0B' if theme == 'dark' else '#92400E' }}" font-family="'Segoe UI', -apple-system, sans-serif" font-size="15" font-weight="700">🔥 贡献热力图</text>
  <text x="732" y="32" text-anchor="end" font-family="'Segoe UI', -apple-system, sans-serif" font-size="12">
    <tspan fill="url(#numGrad)" font-size="16" font-weight="700">{{ total_contribs }}</tspan>
    <tspan fill="{{ '#8B949E' if theme == 'dark' else '#6B7280' }}"> 次贡献 · 连续 </tspan>
    <tspan fill="{{ '#D97706' if theme == 'dark' else '#B45309' }}" font-weight="600">{{ streak }}</tspan>
    <tspan fill="{{ '#8B949E' if theme == 'dark' else '#6B7280' }}"> 天</tspan>
  </text>

  <!-- Heatmap grid -->
  {% for cell in cells %}
  <rect x="{{ cell.x }}" y="{{ cell.y }}" width="11" height="11" rx="2.5" fill="{{ cell.fill }}"/>
  {% endfor %}

  <!-- Month-ish baseline & legend -->
  <text x="24" y="158" fill="{{ '#8B949E' if theme == 'dark' else '#9CA3AF' }}" font-family="'Segoe UI', sans-serif" font-size="9">最近一年</text>
  <text x="608" y="158" fill="{{ '#8B949E' if theme == 'dark' else '#6B7280' }}" font-family="'Segoe UI', sans-serif" font-size="9">Less</text>
  <rect x="630" y="149" width="11" height="11" rx="2.5" fill="{{ '#21262D' if theme == 'dark' else '#E5E7EB' }}"/>
  <rect x="644" y="149" width="11" height="11" rx="2.5" fill="#FEF3C7"/>
  <rect x="658" y="149" width="11" height="11" rx="2.5" fill="#FDE68A"/>
  <rect x="672" y="149" width="11" height="11" rx="2.5" fill="#F59E0B"/>
  <rect x="686" y="149" width="11" height="11" rx="2.5" fill="#92400E"/>
  <text x="700" y="158" fill="{{ '#8B949E' if theme == 'dark' else '#6B7280' }}" font-family="'Segoe UI', sans-serif" font-size="9">More</text>
</svg>
