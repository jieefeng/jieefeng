<svg xmlns="http://www.w3.org/2000/svg" width="730" height="130" viewBox="0 0 730 130">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      {% if theme == "dark" %}
      <stop offset="0%" stop-color="#0D1117"/>
      <stop offset="100%" stop-color="#161B22"/>
      {% else %}
      <stop offset="0%" stop-color="#FFFBEB"/>
      <stop offset="100%" stop-color="#FEF3C7"/>
      {% endif %}
    </linearGradient>
    <linearGradient id="borderGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#92400E"/>
      <stop offset="50%" stop-color="#D97706"/>
      <stop offset="100%" stop-color="#F59E0B"/>
    </linearGradient>
    <filter id="shadow">
      <feDropShadow dx="0" dy="2" stdDeviation="6" flood-color="#D97706" flood-opacity="{{ '0.2' if theme == 'dark' else '0.15' }}"/>
    </filter>
  </defs>
  <rect x="1" y="1" width="728" height="128" rx="12" fill="url(#bg)" filter="url(#shadow)"/>
  <rect x="1" y="1" width="728" height="128" rx="12" fill="none" stroke="url(#borderGrad)" stroke-width="1.5"/>
  <text x="365" y="30" text-anchor="middle" fill="{{ '#D97706' if theme == 'dark' else '#92400E' }}" font-family="'Segoe UI', -apple-system, sans-serif" font-size="14" font-weight="600">🔥 贡献热力图</text>
  {% for cell in cells %}
  <rect x="{{ cell.x }}" y="{{ cell.y }}" width="11" height="11" rx="2" fill="{{ cell.fill }}"/>
  {% endfor %}
  {# Legend #}
  <text x="620" y="120" fill="{{ '#8B949E' if theme == 'dark' else '#6B7280' }}" font-family="'Segoe UI', sans-serif" font-size="9">Less</text>
  <rect x="648" y="110" width="10" height="10" rx="2" fill="{{ '#161B22' if theme == 'dark' else '#E5E7EB' }}"/>
  <rect x="661" y="110" width="10" height="10" rx="2" fill="#FEF3C7"/>
  <rect x="674" y="110" width="10" height="10" rx="2" fill="#F59E0B"/>
  <rect x="687" y="110" width="10" height="10" rx="2" fill="#92400E"/>
  <text x="702" y="120" fill="{{ '#8B949E' if theme == 'dark' else '#6B7280' }}" font-family="'Segoe UI', sans-serif" font-size="9">More</text>
</svg>
