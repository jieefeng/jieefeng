<svg xmlns="http://www.w3.org/2000/svg" width="495" height="{{ 50 + (languages | length) * 32 + 15 }}" viewBox="0 0 495 {{ 50 + (languages | length) * 32 + 15 }}">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      {% if theme == "dark" %}
      <stop offset="0%" stop-color="#0D1117"/>
      <stop offset="100%" stop-color="#161B22"/>
      {% else %}
      <stop offset="0%" stop-color="#FFFBEB"/>
      <stop offset="100%" stop-color="#FEF3C7"/>
      {% endif %}
    </linearGradient>
    <linearGradient id="borderGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#F59E0B"/>
      <stop offset="50%" stop-color="#D97706"/>
      <stop offset="100%" stop-color="#92400E"/>
    </linearGradient>
    <filter id="shadow">
      <feDropShadow dx="0" dy="2" stdDeviation="6" flood-color="#D97706" flood-opacity="{{ '0.2' if theme == 'dark' else '0.15' }}"/>
    </filter>
  </defs>
  {% set h = 50 + (languages | length) * 32 + 15 %}
  <rect x="1" y="1" width="493" height="{{ h - 2 }}" rx="12" fill="url(#bg)" filter="url(#shadow)"/>
  <rect x="1" y="1" width="493" height="{{ h - 2 }}" rx="12" fill="none" stroke="url(#borderGrad)" stroke-width="1.5"/>
  <text x="248" y="36" text-anchor="middle" fill="{{ '#D97706' if theme == 'dark' else '#92400E' }}" font-family="'Segoe UI', -apple-system, sans-serif" font-size="16" font-weight="600">Top Languages</text>
  {% for lang in languages %}
  {% set y_text = 50 + loop.index0 * 32 + 14 %}
  {% set y_bar = 50 + loop.index0 * 32 + 20 %}
  {% set bar_width = [lang.percent * 340 / 100, 2] | max | int %}
  <text x="20" y="{{ y_text }}" fill="{{ '#C9D1D9' if theme == 'dark' else '#1F2937' }}" font-family="'Segoe UI', sans-serif" font-size="13">{{ lang.name }}</text>
  <text x="470" y="{{ y_text }}" text-anchor="end" fill="{{ '#8B949E' if theme == 'dark' else '#6B7280' }}" font-family="'Segoe UI', sans-serif" font-size="12">{{ lang.percent }}%</text>
  <rect x="120" y="{{ y_bar }}" width="340" height="8" rx="4" fill="{{ '#21262D' if theme == 'dark' else '#E5E7EB' }}"/>
  <rect x="120" y="{{ y_bar }}" width="{{ bar_width }}" height="8" rx="4" fill="{{ lang.color }}"/>
  {% endfor %}
</svg>
