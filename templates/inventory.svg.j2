<svg xmlns="http://www.w3.org/2000/svg" width="{{ w }}" height="{{ h }}" viewBox="0 0 {{ w }} {{ h }}"
     role="img"
     aria-label="装备栏：{{ items | map(attribute='name') | join('、') }}">
  <title>装备栏</title>

  {# Every entrance animation moves only transforms: nothing is ever hidden by
     an animation that a static renderer (or a reduced-motion reader) would
     skip, so the card reads identically with animation switched off. #}
  <style>
    @media (prefers-reduced-motion: reduce) {
      * { animation: none !important; }
    }
    @keyframes slotIn { from { transform: translateY(5px) } to { transform: translateY(0) } }
    .slot { animation: slotIn .42s cubic-bezier(.22,.7,.3,1) both }

    @keyframes glowPulse { 0%, 100% { opacity: .35 } 50% { opacity: .8 } }
    .glow { animation: glowPulse 3.8s ease-in-out infinite }

    @keyframes sweep {
      from { transform: translateX(-260px) }
      to   { transform: translateX(760px) }
    }
    .sweep { animation: sweep 7.5s linear -2.2s infinite }
  </style>

  <defs>
    <linearGradient id="invbg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="{{ p.sky_top }}"/>
      <stop offset="1" stop-color="{{ p.sky_bottom }}"/>
    </linearGradient>
    <radialGradient id="legendGlow">
      <stop offset="0" stop-color="{{ p.r_legendary }}" stop-opacity=".5"/>
      <stop offset="1" stop-color="{{ p.r_legendary }}" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="sweepGrad" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="0"/>
      <stop offset=".5" stop-color="{{ p.r_legendary }}" stop-opacity=".10"/>
      <stop offset="1" stop-color="#fff" stop-opacity="0"/>
    </linearGradient>
    <clipPath id="inv"><rect x="1" y="1" width="{{ w - 2 }}" height="{{ h - 2 }}" rx="15"/></clipPath>
  </defs>

  <rect x="1" y="1" width="{{ w - 2 }}" height="{{ h - 2 }}" rx="15"
        fill="{{ p.sky_top }}" stroke="{{ p.ridge_soft }}" stroke-opacity=".55" stroke-width="1.5"/>

  <g clip-path="url(#inv)">
    <rect x="0" y="0" width="{{ w }}" height="{{ h }}" fill="url(#invbg)"/>

    {# A slow highlight crossing the grid: the card is "live" without anything
       that could move text. #}
    <g class="sweep">
      <rect x="0" y="0" width="220" height="{{ h }}" fill="url(#sweepGrad)"
            transform="skewX(-14)"/>
    </g>

    {% for it in items %}
    <g class="slot" style="animation-delay:{{ '%.2f' % (0.05 * loop.index0) }}s">
      {% if it.rarity == 'legendary' %}
      <ellipse class="glow" cx="{{ it.cx }}" cy="{{ it.y + 31 }}" rx="56" ry="40" fill="url(#legendGlow)"/>
      {% endif %}
      <rect x="{{ it.x }}" y="{{ it.y }}" width="{{ it.w }}" height="{{ it.h }}" rx="8"
            fill="{{ p.slot_bg }}" stroke="{{ it.color }}" stroke-opacity="{{ it.stroke_op }}"
            stroke-width="{{ 1.6 if it.rarity == 'legendary' else 1.1 }}"/>
      {% if it.rarity == 'legendary' %}
      <rect x="{{ it.x + 3 }}" y="{{ it.y + 3 }}" width="{{ it.w - 6 }}" height="{{ it.h - 6 }}" rx="6"
            fill="none" stroke="{{ it.color }}" stroke-opacity=".22"/>
      {% endif %}

      <text x="{{ it.cx }}" y="{{ it.y + 26 }}" text-anchor="middle" font-size="9.5"
            font-weight="600" fill="{{ p.text }}">{{ it.name }}</text>
      <text x="{{ it.cx }}" y="{{ it.y + 38 }}" text-anchor="middle" font-size="5.4"
            letter-spacing="1.3" fill="{{ it.color }}" fill-opacity="{{ it.label_op }}">{{ it.rarity_label }}</text>

      {% for pip in it.pips %}
      <rect x="{{ pip.x }}" y="{{ it.y + 46 }}" width="4" height="4" rx="1"
            fill="{{ it.color if pip.on else p.pip_off }}"
            fill-opacity="{{ it.pip_on_op if pip.on else 1 }}"/>
      {% endfor %}
    </g>
    {% endfor %}

    <line x1="26" y1="33.5" x2="{{ w - 26 }}" y2="33.5" stroke="{{ p.muted }}" stroke-opacity=".22"/>

    <g font-family="'JetBrains Mono','Fira Code',Consolas,'Sarasa Mono SC','Noto Sans Mono CJK SC','Microsoft YaHei','PingFang SC',monospace">
      <text x="26" y="24" font-size="7.5" letter-spacing="2.6" fill="{{ p.muted }}">INVENTORY</text>
      <text x="112" y="24" font-size="7.5" fill="{{ p.muted }}" fill-opacity=".75">{{ count }} SLOTS</text>

      {% for lg in legend %}
      <rect x="{{ lg.x }}" y="17.5" width="6" height="6" rx="1.5" fill="{{ lg.color }}"/>
      <text x="{{ lg.x + 10 }}" y="24" font-size="7.5" fill="{{ p.muted }}">{{ lg.label }}<tspan
            fill="{{ p.text }}" font-weight="600" dx="3">{{ lg.count }}</tspan></text>
      {% endfor %}
    </g>
  </g>
</svg>
