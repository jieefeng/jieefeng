<svg xmlns="http://www.w3.org/2000/svg" width="495" height="{{ card_height }}" viewBox="0 0 495 {{ card_height }}">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      {% if theme == "dark" %}
      <stop offset="0%" stop-color="#0D1117"/>
      <stop offset="100%" stop-color="#161B22"/>
      {% else %}
      <stop offset="0%" stop-color="#FFFBEB"/>
      <stop offset="100%" stop-color="#FEF3C7"/>
      {% endif %}
    </linearGradient>
    <linearGradient id="borderGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#92400E"/>
      <stop offset="50%" stop-color="#D97706"/>
      <stop offset="100%" stop-color="#F59E0B"/>
    </linearGradient>
    <filter id="shadow">
      <feDropShadow dx="0" dy="2" stdDeviation="6" flood-color="#D97706" flood-opacity="{{ '0.2' if theme == 'dark' else '0.15' }}"/>
    </filter>
  </defs>
  <rect x="1" y="1" width="493" height="{{ card_height - 2 }}" rx="12" fill="url(#bg)" filter="url(#shadow)"/>
  <rect x="1" y="1" width="493" height="{{ card_height - 2 }}" rx="12" fill="none" stroke="url(#borderGrad)" stroke-width="1.5"/>
  <text x="248" y="36" text-anchor="middle" fill="{{ '#D97706' if theme == 'dark' else '#92400E' }}" font-family="'Segoe UI', -apple-system, sans-serif" font-size="16" font-weight="600">📝 博客 & 🎯 学习目标</text>

  {# Blog links #}
  {% for link in links %}
  {% set y = 55 + loop.index0 * 32 %}
  <rect x="20" y="{{ y }}" width="455" height="26" rx="6" fill="{{ link.color }}" opacity="0.12"/>
  <rect x="20" y="{{ y }}" width="455" height="26" rx="6" fill="none" stroke="{{ link.color }}" stroke-width="0.8" opacity="0.5"/>
  <text x="36" y="{{ y + 17 }}" fill="{{ link.color }}" font-family="'Segoe UI', sans-serif" font-size="12" font-weight="600">{{ link.name }}</text>
  <text x="460" y="{{ y + 17 }}" text-anchor="end" fill="{{ '#8B949E' if theme == 'dark' else '#6B7280' }}" font-family="'Segoe UI', sans-serif" font-size="9">{{ link.url[:45] }}</text>
  {% endfor %}

  {# Learning goals #}
  {% set goals_y = 55 + (links | length) * 32 + 10 %}
  <text x="248" y="{{ goals_y }}" text-anchor="middle" fill="{{ '#D97706' if theme == 'dark' else '#92400E' }}" font-family="'Segoe UI', sans-serif" font-size="12" font-weight="600">🎯 学习目标</text>
  {% for goal in goals %}
  {% set y = goals_y + 16 + loop.index0 * 36 %}
  <text x="20" y="{{ y + 10 }}" fill="{{ '#C9D1D9' if theme == 'dark' else '#374151' }}" font-family="'Segoe UI', sans-serif" font-size="11">{{ goal.name }}</text>
  <text x="470" y="{{ y + 10 }}" text-anchor="end" fill="{{ goal.color }}" font-family="'Segoe UI', sans-serif" font-size="11" font-weight="600">{{ goal.progress }}%</text>
  <rect x="20" y="{{ y + 16 }}" width="455" height="8" rx="4" fill="{{ '#21262D' if theme == 'dark' else '#E5E7EB' }}"/>
  <rect x="20" y="{{ y + 16 }}" width="{{ goal.progress * 455 // 100 }}" height="8" rx="4" fill="{{ goal.color }}"/>
  {% endfor %}
</svg>
