<svg xmlns="http://www.w3.org/2000/svg" width="500" height="{{ height }}" viewBox="0 0 500 {{ height }}" role="img" aria-label="技术栈：{{ groups | map(attribute='name') | join('、') }}">
  <defs>
    <linearGradient id="sbg" x1="0" y1="0" x2="1" y2="1">
      {% if theme == "dark" %}
      <stop offset="0" stop-color="#0D1117"/>
      <stop offset="1" stop-color="#161B22"/>
      {% else %}
      <stop offset="0" stop-color="#FFFBEB"/>
      <stop offset="1" stop-color="#FEF3C7"/>
      {% endif %}
    </linearGradient>
    <linearGradient id="sborder" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#92400E"/>
      <stop offset="0.5" stop-color="#D97706"/>
      <stop offset="1" stop-color="#F59E0B"/>
    </linearGradient>
    <filter id="sshadow" x="-5%" y="-10%" width="110%" height="125%">
      <feDropShadow dx="0" dy="3" stdDeviation="7" flood-color="#D97706" flood-opacity="{{ '0.25' if theme == 'dark' else '0.18' }}"/>
    </filter>
  </defs>

  <rect x="1" y="1" width="498" height="{{ height - 2 }}" rx="14" fill="url(#sbg)" filter="url(#sshadow)"/>
  <rect x="1" y="1" width="498" height="{{ height - 2 }}" rx="14" fill="none" stroke="url(#sborder)" stroke-width="1.5"/>

  {% set muted = '#8B949E' if theme == 'dark' else '#6B7280' %}
  {% set chip_bg = '#1C2128' if theme == 'dark' else '#FFFFFF' %}
  {% set chip_bd = '#30363D' if theme == 'dark' else '#E5E7EB' %}
  {% set chip_tx = '#FDE68A' if theme == 'dark' else '#92400E' %}
  {% set dot = '#F59E0B' if theme == 'dark' else '#D97706' %}

  {% for g in groups %}
  <!-- {{ g.name }} -->
  <text x="28" y="{{ g.label_y }}" fill="{{ muted }}" font-family="'Segoe UI',-apple-system,sans-serif" font-size="11" letter-spacing="1">{{ g.name }}</text>
  {% for c in g.chips %}
  <g font-family="'Segoe UI',-apple-system,sans-serif" font-size="12">
    <rect x="{{ c.x }}" y="{{ c.y }}" width="{{ c.w }}" height="24" rx="12" fill="{{ chip_bg }}" stroke="{{ chip_bd }}"/>
    <circle cx="{{ c.x + 14 }}" cy="{{ c.y + 12 }}" r="3.5" fill="{{ dot }}"/>
    <text x="{{ c.x + 24 }}" y="{{ c.y + 16 }}" fill="{{ chip_tx }}">{{ c.label }}</text>
  </g>
  {% endfor %}
  {% endfor %}
</svg>
