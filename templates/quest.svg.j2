<svg xmlns="http://www.w3.org/2000/svg" width="{{ w }}" height="{{ h }}" viewBox="0 0 {{ w }} {{ h }}"
     role="img"
     aria-label="任务日志：{% for q in quests %}{{ q.title }}（{{ q.status }}，{{ q.progress }}%）{% if not loop.last %}；{% endif %}{% endfor %}">
  <title>任务日志</title>

  {# Animation never carries content: bars are drawn at their final width and
     the pulses are decoration, so a still frame tells the whole story. #}
  <style>
    @media (prefers-reduced-motion: reduce) {
      * { animation: none !important; }
    }
    @keyframes blip { 0%, 100% { opacity: .25 } 50% { opacity: 1 } }
    .blip { animation: blip 2.6s ease-in-out infinite }

    @keyframes scan {
      from { transform: translateX(0) }
      to   { transform: translateX({{ bar_w }}px) }
    }
    .scan { animation: scan 4.4s linear infinite }

    @keyframes rowIn { from { transform: translateX(-6px) } to { transform: translateX(0) } }
    .row { animation: rowIn .45s cubic-bezier(.22,.7,.3,1) both }
  </style>

  <defs>
    <linearGradient id="qbg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="{{ p.sky_top }}"/>
      <stop offset="1" stop-color="{{ p.sky_bottom }}"/>
    </linearGradient>
    <linearGradient id="barfill" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="{{ p.ridge }}" stop-opacity=".55"/>
      <stop offset="1" stop-color="{{ p.r_legendary }}"/>
    </linearGradient>
    <clipPath id="qcard"><rect x="1" y="1" width="{{ w - 2 }}" height="{{ h - 2 }}" rx="15"/></clipPath>
    {% for q in quests %}
    <clipPath id="qb{{ loop.index0 }}"><rect x="{{ bar_x }}" y="{{ q.y + 13 }}" width="{{ q.fill_w }}" height="6" rx="3"/></clipPath>
    {% endfor %}
  </defs>

  <rect x="1" y="1" width="{{ w - 2 }}" height="{{ h - 2 }}" rx="15"
        fill="{{ p.sky_top }}" stroke="{{ p.ridge_soft }}" stroke-opacity=".55" stroke-width="1.5"/>

  <g clip-path="url(#qcard)">
    <rect x="0" y="0" width="{{ w }}" height="{{ h }}" fill="url(#qbg)"/>

    {% for q in quests %}
    <g class="row" style="animation-delay:{{ '%.2f' % (0.06 * loop.index0) }}s">
      {# checkbox #}
      <rect x="26" y="{{ q.y + 2 }}" width="13" height="13" rx="3.5" fill="none"
            stroke="{{ q.accent }}" stroke-opacity=".8"/>
      <rect class="blip" x="30" y="{{ q.y + 6 }}" width="5" height="5" rx="1" fill="{{ q.accent }}"
            style="animation-delay:{{ '%.2f' % (-0.8 * loop.index0) }}s"/>

      <text x="50" y="{{ q.y + 14 }}" font-size="11.5" font-weight="600" fill="{{ p.text }}">{{ q.title }}</text>
      <text x="50" y="{{ q.y + 28 }}" font-size="7.5" fill="{{ p.muted }}" fill-opacity=".9">{{ q.detail }}</text>

      {# progress #}
      <rect x="{{ bar_x }}" y="{{ q.y + 13 }}" width="{{ bar_w }}" height="6" rx="3" fill="{{ p.track }}"/>
      <rect x="{{ bar_x }}" y="{{ q.y + 13 }}" width="{{ q.fill_w }}" height="6" rx="3" fill="url(#barfill)"/>
      {% if q.fill_w > 12 %}
      <g clip-path="url(#qb{{ loop.index0 }})">
        <g class="scan" style="animation-delay:{{ '%.2f' % (-1.7 * loop.index0) }}s">
          <rect x="-30" y="{{ q.y + 11 }}" width="30" height="10" fill="{{ p.r_legendary }}" opacity=".22"/>
        </g>
      </g>
      {% endif %}
      <text x="{{ bar_x + bar_w + 10 }}" y="{{ q.y + 19 }}" font-size="7.5" fill="{{ p.muted }}">{{ q.progress }}%</text>

      {# status chip #}
      <rect x="{{ chip_x }}" y="{{ q.y + 8.5 }}" width="{{ chip_w }}" height="15" rx="7.5"
            fill="{{ q.accent }}" fill-opacity=".10" stroke="{{ q.accent }}" stroke-opacity=".45"/>
      <text x="{{ chip_x + chip_w / 2 }}" y="{{ q.y + 18.5 }}" text-anchor="middle" font-size="7.5"
            fill="{{ q.accent }}">{{ q.status }}</text>
    </g>
    {% endfor %}

    <line x1="26" y1="33.5" x2="{{ w - 26 }}" y2="33.5" stroke="{{ p.muted }}" stroke-opacity=".22"/>
    <line x1="26" y1="{{ footer_rule }}" x2="{{ w - 26 }}" y2="{{ footer_rule }}"
          stroke="{{ p.muted }}" stroke-opacity=".22"/>

    <g font-family="'JetBrains Mono','Fira Code',Consolas,'Sarasa Mono SC','Noto Sans Mono CJK SC','Microsoft YaHei','PingFang SC',monospace">
      <text x="26" y="24" font-size="7.5" letter-spacing="2.6" fill="{{ p.muted }}">QUEST LOG</text>
      <text x="{{ w - 26 }}" y="24" font-size="7.5" fill="{{ p.muted }}" fill-opacity=".75"
            text-anchor="end">{{ quests | length }} ACTIVE · {{ main_count }} MAIN</text>

      <text x="26" y="{{ footer_y }}" font-size="7" letter-spacing="2.2" fill="{{ p.muted }}">CO-OP</text>
      <text x="78" y="{{ footer_y }}" font-size="8" fill="{{ p.text }}" fill-opacity=".82">{{ coop }}</text>
      <text x="{{ w - 26 }}" y="{{ footer_y }}" font-size="7" fill="{{ p.muted }}" fill-opacity=".75"
            text-anchor="end">PARTY OPEN</text>
    </g>
  </g>
</svg>
