<svg xmlns="http://www.w3.org/2000/svg" width="{{ w }}" height="{{ h }}" viewBox="0 0 {{ w }} {{ h }}"
     role="img"
     aria-label="今日签 {{ date_label }} {{ weekday }}：宜 {{ good }}，忌 {{ bad }}">
  <title>今日签</title>

  <style>
    @media (prefers-reduced-motion: reduce) {
      * { animation: none !important; }
    }
    @keyframes blip { 0%, 100% { opacity: .25 } 50% { opacity: 1 } }
    .blip { animation: blip 2.4s ease-in-out infinite }
  </style>

  <defs>
    <linearGradient id="dbg" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="{{ p.sky_bottom }}"/>
      <stop offset="1" stop-color="{{ p.sky_top }}"/>
    </linearGradient>
  </defs>

  <rect x="1" y="1" width="{{ w - 2 }}" height="{{ h - 2 }}" rx="12"
        fill="url(#dbg)" stroke="{{ p.ridge_soft }}" stroke-opacity=".5" stroke-width="1.5"/>

  <g font-family="'JetBrains Mono','Fira Code',Consolas,'Sarasa Mono SC','Noto Sans Mono CJK SC','Microsoft YaHei','PingFang SC',monospace">
    {# --- left: what this strip is -------------------------------------- #}
    <text x="26" y="28" font-size="12.5" font-weight="600" fill="{{ p.text }}">今日签</text>
    <rect class="blip" x="{{ 26 + title_w + 8 }}" y="20" width="5" height="5" rx="1" fill="{{ p.bright }}"/>
    <text x="26" y="45" font-size="7" letter-spacing="2.4" fill="{{ p.muted }}">DAILY ROLL</text>

    <line x1="112" y1="14" x2="112" y2="50" stroke="{{ p.muted }}" stroke-opacity=".2"/>

    {# --- middle: 宜 / 忌 ------------------------------------------------ #}
    <rect x="124" y="16.5" width="20" height="16" rx="4" fill="{{ p.bright }}" fill-opacity=".12"
          stroke="{{ p.bright }}" stroke-opacity=".45"/>
    <text x="134" y="28.5" text-anchor="middle" font-size="10" fill="{{ p.bright }}">宜</text>
    <text x="154" y="28.5" font-size="11.5" fill="{{ p.text }}">{{ good }}</text>

    <rect x="124" y="35.5" width="20" height="16" rx="4" fill="{{ p.scarf }}" fill-opacity=".1"
          stroke="{{ p.scarf }}" stroke-opacity=".4"/>
    <text x="134" y="47.5" text-anchor="middle" font-size="10" fill="{{ p.scarf }}">忌</text>
    <text x="154" y="47.5" font-size="11.5" fill="{{ p.text }}" fill-opacity=".8">{{ bad }}</text>

    {# --- right: the seed this pair came from --------------------------- #}
    <text x="{{ w - 26 }}" y="28" text-anchor="end" font-size="8.5" fill="{{ p.muted }}">{{ date_label }} · {{ weekday }}</text>
    <text x="{{ w - 26 }}" y="45" text-anchor="end" font-size="7" letter-spacing="1.6"
          fill="{{ p.muted }}" fill-opacity=".7">SEED {{ seed }}</text>
  </g>
</svg>
